APP_NAME="AgriSupport Dusk"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database khusus Dusk — TERPISAH dari agrisupport_testing
# Dusk menggunakan DatabaseMigrations (truncate per test, bukan transaksi)
# sehingga tidak boleh berbagi database dengan PHPUnit
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrisupport_dusk
DB_USERNAME=your_username
DB_PASSWORD=your_password

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
