APP_NAME="AgriSupport Testing"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database khusus testing — HARUS PostgreSQL + PostGIS
# Buat database ini secara manual sebelum menjalankan php artisan test
# Lihat docs/skill.md bagian "Setup Database Testing"
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrisupport_testing
DB_USERNAME=your_username
DB_PASSWORD=your_password

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
